# Copy to `.env` and edit. Every script sources it if present.

# Where all datasets, fitted INRs, CNN zoos, and checkpoints live. Needs a few hundred GB
# if you regenerate the large test widths; see the README's disk-footprint note.
export ANYDIM_DATA_ROOT=/path/to/large/disk/anydim-metanet-data

# Optional: only if the CIFAR-10 python-pickle files live outside $ANYDIM_DATA_ROOT.
# Unset, scripts/generate_cnn_zoo.py looks in $ANYDIM_DATA_ROOT/CIFAR10.
# export CIFAR10_ROOT=/path/to/cifar-10-batches-py/parent

# Optional: interpreter used by the launch scripts in scripts/ (default: `python`).
# export PYTHON=/path/to/conda/envs/anydim-metanet/bin/python

# Optional: Slack webhook for scripts/notify_slack.sh. Never commit a real value.
# export SLACK_WEBHOOK_URL=
